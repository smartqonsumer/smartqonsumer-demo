# SmartQonsumer API — copy to .env (never commit .env). No real credential here.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://smartq:smartq@localhost:5440/smartqonsumer

FRONTEND_URL=http://localhost:3010
# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
CORS_ORIGINS=http://localhost:3010
GS1_RESOLVER_URL=http://localhost:8091

# Long random value in every real environment: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-change-me
# Set to ".smartqonsumer.com" in production so the API sub-domain cookie reaches the site
SESSION_COOKIE_DOMAIN=

# console = print emails in the API logs; smtp = send (Mailpit locally: http://localhost:8026)
EMAIL_PROVIDER=smtp
EMAIL_FROM=SmartQonsumer <no-reply@smartqonsumer.com>
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

ANALYTICS_PROVIDER=db
# Démo : lien « Rejouer quand même » sur un QR déjà utilisé (vide = actif hors production)
# ALLOW_SCAN_BYPASS=false
ANONYMOUS_DATA_RETENTION_DAYS=395
