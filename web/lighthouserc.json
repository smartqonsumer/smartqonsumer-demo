{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": [
        "http://localhost/",
        "http://localhost/legal/mentions-legales/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.7
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 600
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 4000
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 560000
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 20000
              }
            ],
            "resource-summary:font:size": [
              "error",
              {
                "maxNumericValue": 160000
              }
            ]
          },
          "aggregationMethod": "median-run"
        },
        {
          "matchingUrlPattern": "^http://[^/]+/$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          },
          "aggregationMethod": "median-run"
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/reports"
    }
  }
}
